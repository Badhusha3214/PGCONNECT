# ─── Supabase ────────────────────────────────────────────────────────────────
# Dashboard → Settings → API
# "Project URL"
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# "anon" public key (safe to expose in browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ─── Backend (Hono on Cloudflare Workers) ────────────────────────────────────
# Local dev: wrangler dev runs on 8787 by default
# Production: your deployed Workers URL e.g. https://pgconnect-backend.yourname.workers.dev
NEXT_PUBLIC_API_URL=http://localhost:8787

# ─── Razorpay ────────────────────────────────────────────────────────────────
# The publishable key ID — goes in the browser for Razorpay checkout
# Must match RAZORPAY_KEY_ID in backend/.dev.vars
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXXXXXX

# ─── Public site URL ─────────────────────────────────────────────────────────
# Used for canonicals, sitemap.xml and Open Graph URLs. MUST be set in production,
# otherwise search engines are told every page lives on localhost.
NEXT_PUBLIC_SITE_URL=https://your-domain.com
